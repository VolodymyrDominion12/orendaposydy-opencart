# ---------------------------------------------------------------------------
# Налаштування локального середовища orendaposydy.com (OpenCart 3).
#
# Скопіюйте цей файл у .env:   cp .env.example .env
# (або одразу:                 make init)
#
# .env НЕ комітиться в git (див. .gitignore).
# ---------------------------------------------------------------------------

# --- Версія PHP -----------------------------------------------------------
# 7.4 — рекомендовано (найближча робоча до продакшену, там PHP 7.3.33)
# 7.3 — точна відповідність продакшену (образ EOL, може не зібратись)
PHP_VERSION=7.4

# --- Порти на хості -------------------------------------------------------
# Зсунуті відносно mrestus-opencart, щоб обидва проєкти могли працювати
# одночасно. Якщо порт зайнятий — змініть тут і зробіть: make restart
WEB_PORT=8090
ADMINER_PORT=8091
DB_PORT=3308
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# --- Адреса, за якою ви відкриваєте сайт -----------------------------------
# Потрапляє в config.php (HTTP_SERVER). Завершальний слеш обов'язковий.
SITE_URL=http://localhost:8090/

# --- База даних -----------------------------------------------------------
# На проді (cPanel, phpMyAdmin) база називається matusuni_kozak,
# користувач такий самий, префікс таблиць oc_.
# Локально імена можуть бути будь-якими — головне, щоб збігався DB_PREFIX.
DB_NAME=matusuni_kozak
DB_USER=matusuni_kozak
DB_PASSWORD=kozak
DB_ROOT_PASSWORD=root
DB_PREFIX=oc_

# --- UID/GID вашого користувача на хості ----------------------------------
# Потрібно, щоб контейнерний www-data збігався з вами і не ламав права
# на файли. Дізнатись: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# --- Часовий пояс ---------------------------------------------------------
TZ=Europe/Kyiv

# ===========================================================================
# ДЕПЛОЙ НА ПРОД (використовується лише tools/deploy.sh)
# ===========================================================================
# Прод: спільний хостинг HOSTiQ, cPanel-акаунт matusuni,
# сервер eushared20.twinservers.net (31.131.26.121), SSH закритий → FTP.

# --- Спосіб доставки файлів -----------------------------------------------
# ftp — через FTP-акаунт із cPanel
# zip — зібрати архів для ручного завантаження через файловий менеджер
DEPLOY_METHOD=ftp

# --- FTP (cPanel → FTP Accounts) ------------------------------------------
# ВАЖЛИВО: FTP-акаунт бачить ДОМАШНЮ теку акаунта matusuni, у якій лежать
# усі сайти: orendaposydy.com/, public_html/ (mrestus), orendaposudu.online/…
# Тому FTP_REMOTE_DIR — це тека конкретного сайту, а не public_html.
FTP_HOST=ftp.orendaposydy.com
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=orendaposydy.com
# yes — FTPS (явний TLS). Сервер це підтримує (Pure-FTPd [TLS]);
# якщо заливка падає з "SSL connect error" — поставте no.
FTP_TLS=no

# На проді кеш/логи/сесії лежать у storage_kozak/ (а не system/storage/).
# Використовується під час деплою для очищення кешу (--clear-cache).
REMOTE_STORAGE_DIR=storage_kozak

# 017: тека адмінки на проді. Локально завжди src/admin/; деплой підміняє admin/ → цю теку.
# Не вписуйте вручну: виставляє `make sec-rename-admin APPLY=1` після успішного перейменування.
# Назву не публікувати (git, чати, скриншоти). Порожньо або admin — стандартна адреса.
REMOTE_ADMIN_DIR=admin

# Основний домен (017): дзеркала www./orendaposydy.com → 301 сюди. Для перевірок і prod-security.sh.
PROD_URL=https://orendaposudu.com

# --- Локальний бекап перед кожним деплоєм ---------------------------------
BACKUP_KEEP=10
