{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ flush_action }}" data-toggle="tooltip" title="{{ button_flush_cache }}" class="btn btn-warning"><i class="fa fa-refresh"></i> {{ button_flush_cache }}</a>
        <a href="{{ clear_404_action }}" onclick="return confirm('{{ text_confirm }}');" data-toggle="tooltip" title="{{ button_clear_404 }}" class="btn btn-danger"><i class="fa fa-trash"></i> {{ button_clear_404 }}</a>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <!-- Форма додавання редиректу -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-plus-circle"></i> {{ button_add_redirect }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" class="form-horizontal">
          <input type="hidden" name="action" value="add" />
          
          <div class="form-group {% if error_old_path %}has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-old-path">{{ entry_old_path }}</label>
            <div class="col-sm-10">
              <input type="text" name="old_path" value="{{ prefill_old_path }}" placeholder="/staryi-url" id="input-old-path" class="form-control" required />
              {% if error_old_path %}
              <div class="text-danger">{{ error_old_path }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group {% if error_new_path %}has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-new-path">{{ entry_new_path }}</label>
            <div class="col-sm-10">
              <input type="text" name="new_path" value="" placeholder="/novyi-rozdil або https://..." id="input-new-path" class="form-control" required />
              {% if error_new_path %}
              <div class="text-danger">{{ error_new_path }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-code">{{ entry_code }}</label>
            <div class="col-sm-4">
              <select name="code" id="input-code" class="form-control">
                <option value="301" selected="selected">301 — Постійне переміщення (Permanent)</option>
                <option value="302">302 — Тимчасове переміщення (Found)</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-4">
              <select name="status" id="input-status" class="form-control">
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <div class="col-sm-10 col-sm-offset-2">
              <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_add_redirect }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Таблиця існуючих редиректів -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-exchange"></i> {{ text_list }} ({{ redirects|length }})</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th>{{ column_old_path }}</th>
                <th>{{ column_new_path }}</th>
                <th class="text-center" style="width: 80px;">{{ column_code }}</th>
                <th class="text-center" style="width: 100px;">{{ column_hits }}</th>
                <th class="text-center" style="width: 160px;">{{ column_last_hit_at }}</th>
                <th class="text-center" style="width: 100px;">{{ column_status }}</th>
                <th class="text-right" style="width: 90px;">{{ column_action }}</th>
              </tr>
            </thead>
            <tbody>
              {% if redirects %}
              {% for redirect in redirects %}
              <tr>
                <td><code>{{ redirect.old_path }}</code></td>
                <td><a href="{{ redirect.new_path }}" target="_blank" rel="noopener"><code>{{ redirect.new_path }}</code></a></td>
                <td class="text-center"><span class="badge">{{ redirect.code }}</span></td>
                <td class="text-center">{{ redirect.hits }}</td>
                <td class="text-center">{{ redirect.last_hit_at }}</td>
                <td class="text-center">{{ redirect.status }}</td>
                <td class="text-right">
                  <a href="{{ redirect.delete }}" onclick="return confirm('{{ text_confirm }}');" data-toggle="tooltip" title="Видалити" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></a>
                </td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="7">{{ text_no_results }}</td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Таблиця 404 журналу -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> {{ text_404_list }} ({{ logs404|length }})</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th>{{ column_path }}</th>
                <th class="text-center" style="width: 100px;">{{ column_hits }}</th>
                <th>{{ column_referer }}</th>
                <th class="text-center" style="width: 160px;">{{ column_last_at }}</th>
                <th class="text-right" style="width: 140px;">{{ column_action }}</th>
              </tr>
            </thead>
            <tbody>
              {% if logs404 %}
              {% for item in logs404 %}
              <tr>
                <td><code>{{ item.path }}</code></td>
                <td class="text-center"><b>{{ item.hits }}</b></td>
                <td>{{ item.referer }}</td>
                <td class="text-center">{{ item.last_at }}</td>
                <td class="text-right">
                  <a href="{{ item.create }}" class="btn btn-info btn-xs"><i class="fa fa-plus"></i> {{ button_create_redirect }}</a>
                </td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="5">{{ text_no_results }}</td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>
{{ footer }}
