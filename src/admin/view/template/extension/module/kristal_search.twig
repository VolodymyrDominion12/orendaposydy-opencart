{# Фіча 027: «Крістал: пошук». Автоекранування в OpenCart вимкнене — дані виводимо через |e. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-kristal-search" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_note }}</div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-kristal-search" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-synonyms"><span data-toggle="tooltip" title="{{ help_synonyms|e }}">{{ entry_synonyms }}</span></label>
            <div class="col-sm-10">
              <textarea name="synonyms" rows="14" id="input-synonyms" class="form-control" style="font-family: monospace;" placeholder="келих = фужер, бокал">{{ synonyms|e }}</textarea>
              <p class="help-block">{{ help_synonyms }} {{ text_groups|format(groups) }}</p>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-search"></i> {{ text_index }}</h3></div>
      <div class="panel-body">
        {% if stats.products %}
        <p>{{ text_index_stats|format(stats.products, stats.categories, stats.words) }}</p>
        {% else %}
        <div class="alert alert-warning">{{ text_index_empty }}</div>
        {% endif %}
        <form action="{{ reindex }}" method="post">
          <button type="submit" class="btn btn-default"><i class="fa fa-refresh"></i> {{ button_reindex }}</button>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_log }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_log_help }}</p>
        {% if log %}
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead><tr><th>{{ column_query }}</th><th class="text-right">{{ column_hits }}</th><th>{{ column_last }}</th></tr></thead>
            <tbody>
              {% for row in log %}
              <tr><td>{{ row.query|e }}</td><td class="text-right">{{ row.hits }}</td><td>{{ row.last_at }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <form action="{{ clear_log }}" method="post" onsubmit="return confirm('{{ text_confirm|e('js') }}');">
          <button type="submit" class="btn btn-danger"><i class="fa fa-trash-o"></i> {{ button_clear_log }}</button>
        </form>
        {% else %}
        <p>{{ text_log_empty }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
