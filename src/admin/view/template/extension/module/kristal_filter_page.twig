{# Фіча 021: форма SEO-сторінки фільтра. Значення POST/БД уже закодовані ядром — виводимо як є; текст — summernote. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-kristal-filter-page" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ text_page_form }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li>{% if breadcrumb.href %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% else %}{{ breadcrumb.text }}{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-kristal-filter-page" class="form-horizontal">
          <div class="form-group required{% if errors.category_id %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-category">{{ entry_category }}</label>
            <div class="col-sm-10">
              <select name="category_id" id="input-category" class="form-control">
                <option value="">{{ text_select }}</option>
                {% for category in categories %}<option value="{{ category.category_id }}"{% if category.category_id == category_id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}
              </select>
              {% if errors.category_id %}<div class="text-danger">{{ errors.category_id }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group required{% if errors.filters %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-filters">{{ entry_filters }}</label>
            <div class="col-sm-10">
              <select name="filters[]" id="input-filters" class="form-control" multiple size="10">
                {% for group in groups %}
                <optgroup label="{{ group.name }}">
                  {% for fid, name in group.values %}<option value="{{ fid }}"{% if fid in filters %} selected{% endif %}>{{ name }}</option>{% endfor %}
                </optgroup>
                {% endfor %}
              </select>
              {% if errors.filters %}<div class="text-danger">{{ errors.filters }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group required{% if errors.keyword %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-keyword">{{ entry_keyword }}</label>
            <div class="col-sm-10">
              <input type="text" name="keyword" value="{{ keyword }}" id="input-keyword" class="form-control" maxlength="64" pattern="[a-z0-9]+(-[a-z0-9]+)*">
              <p class="help-block">{{ help_keyword }}</p>
              {% if errors.keyword %}<div class="text-danger">{{ errors.keyword }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group required{% if errors.h1 %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-h1">{{ entry_h1 }}</label>
            <div class="col-sm-10">
              <input type="text" name="h1" value="{{ h1 }}" id="input-h1" class="form-control" maxlength="255">
              {% if errors.h1 %}<div class="text-danger">{{ errors.h1 }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group{% if errors.title %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-title">{{ entry_title }}</label>
            <div class="col-sm-10">
              <input type="text" name="title" value="{{ title }}" id="input-title" class="form-control" maxlength="255">
              {% if errors.title %}<div class="text-danger">{{ errors.title }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group{% if errors.description %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-description">{{ entry_description }}</label>
            <div class="col-sm-10">
              <textarea name="description" rows="3" id="input-description" class="form-control" maxlength="255">{{ description }}</textarea>
              {% if errors.description %}<div class="text-danger">{{ errors.description }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-text">{{ entry_text }}</label>
            <div class="col-sm-10">
              <textarea name="text" id="input-text" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ text }}</textarea>
              <p class="help-block">{{ help_text }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <input type="checkbox" name="status" value="1" id="input-status"{% if status %} checked{% endif %} style="margin-top:10px">
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
