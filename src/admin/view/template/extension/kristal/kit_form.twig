{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-kit" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-kit" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">Основне</a></li>
            <li><a href="#tab-items" data-toggle="tab">Товари комплекту</a></li>
          </ul>
          <div class="tab-content">
            <!-- Вкладка Основне -->
            <div class="tab-pane active" id="tab-general">
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
                <div class="col-sm-10">
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-code">{{ entry_code }}</label>
                <div class="col-sm-10">
                  <input type="text" name="code" value="{{ code }}" placeholder="wedding_standard" id="input-code" class="form-control" />
                  {% if error_code %}
                  <div class="text-danger">{{ error_code }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-event-type">{{ entry_event_type }}</label>
                <div class="col-sm-10">
                  <select name="event_type" id="input-event-type" class="form-control">
                    <option value="wedding"{% if event_type == 'wedding' %} selected="selected"{% endif %}>{{ text_event_wedding }}</option>
                    <option value="buffet"{% if event_type == 'buffet' %} selected="selected"{% endif %}>{{ text_event_buffet }}</option>
                    <option value="banquet"{% if event_type == 'banquet' %} selected="selected"{% endif %}>{{ text_event_banquet }}</option>
                    <option value="corporate"{% if event_type == 'corporate' %} selected="selected"{% endif %}>{{ text_event_corporate }}</option>
                    <option value="birthday"{% if event_type == 'birthday' %} selected="selected"{% endif %}>{{ text_event_birthday }}</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-tier">{{ entry_tier }}</label>
                <div class="col-sm-10">
                  <select name="tier" id="input-tier" class="form-control">
                    <option value="basic"{% if tier == 'basic' %} selected="selected"{% endif %}>{{ text_tier_basic }}</option>
                    <option value="standard"{% if tier == 'standard' %} selected="selected"{% endif %}>{{ text_tier_standard }}</option>
                    <option value="premium"{% if tier == 'premium' %} selected="selected"{% endif %}>{{ text_tier_premium }}</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-badge">{{ entry_badge }}</label>
                <div class="col-sm-10">
                  <input type="text" name="badge" value="{{ badge }}" placeholder="Найчастіше беруть" id="input-badge" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-discount">{{ entry_discount_pct }}</label>
                <div class="col-sm-10">
                  <input type="number" step="0.01" min="0" max="100" name="discount_pct" value="{{ discount_pct }}" id="input-discount" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-features">{{ entry_features }}</label>
                <div class="col-sm-10">
                  <textarea name="features" rows="5" placeholder='[{"text":"Тарілки Classic","included":true}]' id="input-features" class="form-control">{{ features }}</textarea>
                  <p class="help-block">JSON масив пунктів переваг: <code>[{"text": "...", "included": true/false}]</code></p>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="number" name="sort_order" value="{{ sort_order }}" id="input-sort-order" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="status" id="input-status" class="form-control">
                    <option value="1"{% if status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Вкладка Товари комплекту -->
            <div class="tab-pane" id="tab-items">
              <div class="table-responsive">
                <table id="kit-items" class="table table-striped table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left" style="width: 40%;">{{ entry_product }}</td>
                      <td class="text-right" style="width: 20%;">{{ entry_qty_per_guest }}</td>
                      <td class="text-right" style="width: 20%;">{{ entry_qty_fixed }}</td>
                      <td class="text-right" style="width: 10%;">{{ entry_sort_order }}</td>
                      <td style="width: 10%;"></td>
                    </tr>
                  </thead>
                  <tbody>
                    {% set item_row = 0 %}
                    {% for item in items %}
                    <tr id="item-row{{ item_row }}">
                      <td class="text-left">
                        <input type="text" name="items[{{ item_row }}][name]" value="{{ item.name }}" placeholder="{{ entry_product }}" class="form-control autocomplete-product" data-row="{{ item_row }}" />
                        <input type="hidden" name="items[{{ item_row }}][product_id]" value="{{ item.product_id }}" id="item-product-id{{ item_row }}" />
                        {% if item.price %}<small class="text-muted">Ціна: {{ item.price }} ₴</small>{% endif %}
                      </td>
                      <td class="text-right">
                        <input type="number" step="0.01" min="0" name="items[{{ item_row }}][qty_per_guest]" value="{{ item.qty_per_guest }}" class="form-control text-right" />
                      </td>
                      <td class="text-right">
                        <input type="number" min="0" name="items[{{ item_row }}][qty_fixed]" value="{{ item.qty_fixed }}" class="form-control text-right" />
                      </td>
                      <td class="text-right">
                        <input type="number" name="items[{{ item_row }}][sort_order]" value="{{ item.sort_order }}" class="form-control text-right" />
                      </td>
                      <td class="text-center">
                        <button type="button" onclick="$('#item-row{{ item_row }}').remove();" data-toggle="tooltip" title="{{ button_remove_item }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                      </td>
                    </tr>
                    {% set item_row = item_row + 1 %}
                    {% endfor %}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="4"></td>
                      <td class="text-center">
                        <button type="button" onclick="addItem();" data-toggle="tooltip" title="{{ button_add_item }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
var item_row = {{ item_row }};

function addItem() {
  html  = '<tr id="item-row' + item_row + '">';
  html += '  <td class="text-left">';
  html += '    <input type="text" name="items[' + item_row + '][name]" value="" placeholder="{{ entry_product }}" class="form-control autocomplete-product" data-row="' + item_row + '" />';
  html += '    <input type="hidden" name="items[' + item_row + '][product_id]" value="" id="item-product-id' + item_row + '" />';
  html += '  </td>';
  html += '  <td class="text-right"><input type="number" step="0.01" min="0" name="items[' + item_row + '][qty_per_guest]" value="1.00" class="form-control text-right" /></td>';
  html += '  <td class="text-right"><input type="number" min="0" name="items[' + item_row + '][qty_fixed]" value="0" class="form-control text-right" /></td>';
  html += '  <td class="text-right"><input type="number" name="items[' + item_row + '][sort_order]" value="' + item_row + '" class="form-control text-right" /></td>';
  html += '  <td class="text-center"><button type="button" onclick="$(\'#item-row' + item_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove_item }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
  html += '</tr>';

  $('#kit-items tbody').append(html);
  initAutocomplete($('#item-row' + item_row + ' .autocomplete-product'));
  item_row++;
}

function initAutocomplete(element) {
  element.autocomplete({
    'source': function(request, response) {
      $.ajax({
        url: 'index.php?route=extension/kristal/kit/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) {
            return {
              label: item['name'] + ' (' + item['price'] + ' ₴)',
              value: item['product_id'],
              name: item['name']
            }
          }));
        }
      });
    },
    'select': function(item) {
      var row = $(this).attr('data-row');
      $(this).val(item['name']);
      $('#item-product-id' + row).val(item['value']);
    }
  });
}

$(document).ready(function() {
  $('.autocomplete-product').each(function() {
    initAutocomplete($(this));
  });
});
//--></script>
{{ footer }}
