{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-calc-norm" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-calc-norm" class="form-horizontal">

          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-category">{{ entry_category }}</label>
            <div class="col-sm-10">
              <select name="category_type" id="input-category" class="form-control">
                <option value="plates"{% if category_type == 'plates' %} selected{% endif %}>{{ text_cat_plates }}</option>
                <option value="cutlery"{% if category_type == 'cutlery' %} selected{% endif %}>{{ text_cat_cutlery }}</option>
                <option value="glass"{% if category_type == 'glass' %} selected{% endif %}>{{ text_cat_glass }}</option>
              </select>
            </div>
          </div>

          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-product-classic"><span data-toggle="tooltip" title="{{ help_product_classic }}">{{ entry_product_classic }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="product_name_classic" value="{{ product_name_classic }}" placeholder="{{ entry_product_classic }}" id="input-product-classic" class="form-control" />
              <input type="hidden" name="product_id_classic" value="{{ product_id_classic }}" id="input-product-id-classic" />
              {% if error_product_classic %}
              <div class="text-danger">{{ error_product_classic }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-product-royal"><span data-toggle="tooltip" title="{{ help_product_royal }}">{{ entry_product_royal }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="product_name_royal" value="{{ product_name_royal }}" placeholder="{{ entry_product_royal }}" id="input-product-royal" class="form-control" />
              <input type="hidden" name="product_id_royal" value="{{ product_id_royal }}" id="input-product-id-royal" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-norm-banquet">{{ entry_norm_banquet }}</label>
            <div class="col-sm-10">
              <input type="number" step="0.05" min="0" name="norm_banquet" value="{{ norm_banquet }}" id="input-norm-banquet" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-norm-buffet">{{ entry_norm_buffet }}</label>
            <div class="col-sm-10">
              <input type="number" step="0.05" min="0" name="norm_buffet" value="{{ norm_buffet }}" id="input-norm-buffet" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-norm-coffee">{{ entry_norm_coffee }}</label>
            <div class="col-sm-10">
              <input type="number" step="0.05" min="0" name="norm_coffee" value="{{ norm_coffee }}" id="input-norm-coffee" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-dish-rule">{{ entry_dish_rule }}</label>
            <div class="col-sm-10">
              <select name="dish_rule" id="input-dish-rule" class="form-control">
                <option value=""{% if not dish_rule %} selected{% endif %}>{{ text_dish_rule_none }}</option>
                <option value="extra_if_4_dishes"{% if dish_rule == 'extra_if_4_dishes' %} selected{% endif %}>{{ text_dish_rule_extra4 }}</option>
                <option value="skip_if_2_dishes_non_banquet"{% if dish_rule == 'skip_if_2_dishes_non_banquet' %} selected{% endif %}>{{ text_dish_rule_skip2 }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-drink-filter">{{ entry_drink_filter }}</label>
            <div class="col-sm-10">
              <select name="drink_filter" id="input-drink-filter" class="form-control">
                <option value=""{% if not drink_filter %} selected{% endif %}>{{ text_drink_none }}</option>
                <option value="wine"{% if drink_filter == 'wine' %} selected{% endif %}>{{ text_drink_wine }}</option>
                <option value="champ"{% if drink_filter == 'champ' %} selected{% endif %}>{{ text_drink_champ }}</option>
                <option value="strong"{% if drink_filter == 'strong' %} selected{% endif %}>{{ text_drink_strong }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-pack-size"><span data-toggle="tooltip" title="{{ help_pack_size }}">{{ entry_pack_size }}</span></label>
            <div class="col-sm-10">
              <input type="number" min="1" name="pack_size" value="{{ pack_size }}" id="input-pack-size" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" name="sort_order" value="{{ sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                <option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
// Автодоповнення для товару Classic
$('input[name=\'product_name_classic\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=extension/kristal/calculator/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return {
            label: item['name'] + ' (' + item['price'] + ' ₴)',
            value: item['product_id'],
            name: item['name']
          }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'product_name_classic\']').val(item['name']);
    $('input[name=\'product_id_classic\']').val(item['value']);
  }
});

// Автодоповнення для товару Royal
$('input[name=\'product_name_royal\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=extension/kristal/calculator/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return {
            label: item['name'] + ' (' + item['price'] + ' ₴)',
            value: item['product_id'],
            name: item['name']
          }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'product_name_royal\']').val(item['name']);
    $('input[name=\'product_id_royal\']').val(item['value']);
  }
});
//--></script>
{{ footer }}
