{{ header }}
    <div class="order content">
        <div class="container-fluid">
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}{% if not loop.last %}<span>-</span>{% endif %}</a></li>
                {% endfor %}
            </ul>
        </div>
        {% if products %}
        <div class="container-lg container-fluid">
            <div class="row justify-content-center">
                <div class="col-xl-10">
                    <h1 class="order-title text-center">{{ heading_title }}</h1>
                    <div class="order-products" id="order-products">
                        <div class="d-md-flex d-none flex-wrap">
                            <div class="order-products-name mb-3">{{ column_name }}</div>
                            <div class="order-products-price">{{ column_price }}</div>
                            <div class="order-products-qty">{{ column_quantity }}</div>
                            <div class="order-products-sum">{{ column_total }}</div>
                            <div class="order-products-remove"></div>
                        </div>
                        <div class="d-md-flex d-none">
                            <div class="hr"></div>
                        </div>
                        {% for product in products %}
                        <div class="d-flex flex-wrap align-items-center order-products-block" id="product-{{ product.product_id }}">
                            <div class="order-products-name">
                                {% if product.thumb %}
                                    <a href="{{ product.href }}">
                                        <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-fluid" />
                                    </a>
                                {% endif %}
                                <a href="{{ product.href }}">{{ product.name }}</a>
                            </div>
                            <div class="order-products-price">
                                <span class="order-products-price-number">{{ product.js_price }}</span>
                                <span class="order-products-price-cur">{{ currency }}</span>
                            </div>
                            <div class="order-products-qty">
                                <i class="fa fa-minus" aria-hidden="true" onclick="minus({{ product.product_id }})"></i>
                                <span class="order-products-quantity-{{ product.product_id }}">{{ product.quantity }}</span>
                                <i class="fa fa-plus" aria-hidden="true" onclick="plus({{ product.product_id }})"></i>
                            </div>
                            <div class="order-products-sum">{{ product.total }}</div>
                            <div class="order-products-remove"><i class="fa fa-times-circle" onclick="cart.remove('{{ product.cart_id }}');"></i></div>
                        </div>
                        {% endfor %}
                        <div class="order-products-delivery"  id="order-products-delivery" style="display: none">{{ text_delivery }} <span></span>{{ currency }}</div>
                        <div class="row order-products-total align-items-center">
                            <div class="col-xl-6"><div class="order-products-total-sum">{{ cart_total_text }}</div></div>
                            <div class="col-xl-6"><div class="order-products-total-price text-right">{{ cart_sum_text }}</div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-xl-10">
                    <div class="order-products order-delivery">
                        <h2 class="text-center">{{ text_comment }}</h2>
                        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="order-form">
                            <div class="d-flex flex-wrap order-products-info">
                                <div class="order-delivery-input">
                                    <label for="input-name">{{ text_name }}</label>
                                    <input type="text" name="name" id="input-name">
                                    {% if error_name %}
                                        <div class="text-danger">{{ error_name }}</div>
                                    {% endif %}
                                </div>
                                <div class="order-delivery-input">
                                    <label for="input-phone">{{ text_phone }}</label>
                                    <input type="text" name="phone" id="input-phone">
                                    {% if error_phone %}
                                        <div class="text-danger">{{ error_phone }}</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="d-flex order-products-info">
                                <div class="order-delivery-textarea">
                                    <label for="input-address">{{ text_address }}</label>
                                    <textarea rows="3" type="text" name="address" id="input-address"></textarea>
                                </div>
                            </div>
                            <div class="d-flex order-products-info">
                                <div class="order-method order-products-info" id="shipping-method"></div>
                            </div>
                            <div class="d-flex">
                                <div class="order-method"  id="payment-method"></div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="container-lg container-fluid">
            <div class="row justify-content-center">
                <div class="col-xl-10">
                    <h1 class="order-title text-center">{{ text_empty }}</h1>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
{% if products %}
<script>
    
    function iteration(f,t){
        $('#total').countTo({
            from: f,
            to: t,
            speed: 300,
            refreshInterval: 3,
            onComplete: function(value) {}
        });
    }
    
    function total() {
        setTimeout(function () {
            let price = $('#total');
            let qty = $('#qty');
            let shipping = parseFloat($('#shipping-method').find('input:checked').data('cost'));
            shipping = shipping ? shipping : 0;
            $.ajax({
                url: 'index.php?route=checkout/order/getTotal',
                dataType: 'json',
                success: function (json) {
                    let json_total = json.total + shipping;
                    if(parseFloat(json_total) !== parseFloat(price.text())){
                        iteration(parseFloat(price.text()),json_total);
                    }
                    qty.text(json.qty);
                }
            });
        }, 300);
    }
    
    function plus(product_id){
        setTimeout(function () {
            $.ajax({
                url: 'index.php?route=checkout/cart/add',
                type: 'post',
                data: {
                    product_id: product_id
                },
                dataType: 'json',
                success: function(json) {
                    let count = $('.order-products-quantity-' + product_id);
                    count.text(+count.text() + 1);
                    $('#cart-count').text(json['total']);
                    let product = $('#product-' + product_id);
                    let cur = product.find('.order-products-price-cur').text();
                    let qty = +product.find('.order-products-quantity-' + product_id).text();
                    let price = +product.find('.order-products-price-number').text();
                    let res = qty * price;
                    product.find('.order-products-sum').text(res + cur);
                    total();
                    shipping();
                }
            });
        }, 100);
    }
    
    function minus(product_id){
        let count = $('.order-products-quantity-' + product_id);
        
        setTimeout(function () {
            if(+count.text() > 1){
                $.ajax({
                    url: 'index.php?route=checkout/cart/add',
                    type: 'post',
                    data: {
                        product_id: product_id,
                        quantity:-1
                    },
                    dataType: 'json',
                    success: function(json) {
                        count.text(+count.text() - 1);
                        $('#cart-count').text(json['total']);
                        let product = $('#product-' + product_id);
                        let cur = product.find('.order-products-price-cur').text();
                        let qty = +product.find('.order-products-quantity-' + product_id).text();
                        let price = +product.find('.order-products-price-number').text();
                        let res = qty * price;
                        product.find('.order-products-sum').text(res + cur);
                        total();
                        shipping();
                    }
                });
            }
        }, 100);
    }
    
    function payment(){
        let type = '';
        let payment = $('#payment-method');
        
        if(payment.height() !== 0){
            type = payment.find('input:checked').val();
        }
        
        $.ajax({
            url: 'index.php?route=checkout/order/payment',
            dataType: 'html',
            type: 'post',
            data: {'type':type},
            success: function(html) {
                payment.html(html);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }
    
    function shipping(){
        let type = '';
        let shipping = $('#shipping-method');

        if(shipping.height() !== 0){
            type = shipping.find('input:checked').val();
        }
        
        $.ajax({
            url: 'index.php?route=checkout/order/shipping',
            dataType: 'html',
            type: 'post',
            data: {'type':type},
            success: function(html) {
                shipping.html(html);
                setTimeout(function () {
                    let cost = parseInt(shipping.find('input:checked').data('cost'));
                    let delivery = $('#order-products-delivery');
                    if(cost > 0){
                        delivery.find('span').text(cost);
                        delivery.slideDown();
                    } else {
                        delivery.slideUp(
                            function () {
                                delivery.find('span').text(cost);
                            }
                        );
                    }
                    total();
                },300);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }
    
    function confirm(){
        $.ajax({
            url: 'index.php?route=checkout/order/confirm',
            dataType: 'html',
            type: 'POST',
            data: {
                'name':$('#input-name').val(),
                'phone':$('#input-phone').val(),
                'shipping_method':$('#shipping-method').find('input:checked').val(),
                'payment_method':$('#payment-method').find('input:checked').val(),
                'address':$('#input-address').val(),
            },
            beforeSend: function() {
                $('.order-products').append('<div class="preloader"></div>');
                setTimeout(function () {
                    $('.preloader').addClass('active');
                },300);
            },
            success: function(html) {
                $('.order-products-info').slideUp("fast", function () {
                    $(this).remove();
                });
                $('.order-products-qty').find('.fa-minus,.fa-plus').slideUp("fast", function () {
                    $(this).remove();
                });
                $('.order-products-remove').slideUp("fast", function () {
                    $(this).remove();
                });
                
                $('#fondy').html(html);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }
    
    function validate(){
        let name = $('#input-name').val().length > 1 && $('#input-name').val().length < 32;
        let phone = /^(\s*)?(\+)?([- _():=+]?\d[- _():=+]?){9,14}(\s*)?$/.test($('#input-phone').val());
        
        if(name && phone){
            $('.text-danger-name').remove();
            $('.text-danger-phone').remove();
            $('.text-danger').remove();
            return true;
        } else {
            $('.text-danger-name').remove();
            $('.text-danger-phone').remove();
            $('.text-danger').remove();
            if(!name){
                $('#input-name').after('<div class="text-danger text-danger-name">{{ error_jsname|escape }}</div>');
            }
            if(!phone){
                $('#input-phone').after('<div class="text-danger text-danger-phone">{{ error_jsphone|escape }}</div>');
            }
            return false;
        }
    }
    
    $(document).ready(function () {
        shipping();
        payment();
        
        $("#payment-method").on('change', function () {
            payment();
        });
        
        $("#payment-method").on('click', '#confirm', function () {
            if(validate()){
                confirm();
            }
        });

        $("#shipping-method").on('change', function () {
            shipping();
        });
    });
</script>
{% endif %}

{{ footer }}