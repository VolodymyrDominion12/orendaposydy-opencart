<!DOCTYPE html>
<!--[if IE]><![endif]-->
<!--[if IE 8 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie8"><![endif]-->
<!--[if IE 9 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie9"><![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
<html dir="{{ direction }}" lang="{{ lang }}">
<!--<![endif]-->
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{{ title }}</title>
    <base href="{{ base }}" />
    {% if description %}
        <meta name="description" content="{{ description }}" />
    {% endif %}
    {% if keywords %}
        <meta name="keywords" content="{{ keywords }}" />
    {% endif %}
    <script src="https://code.jquery.com/jquery-3.4.1.min.js" integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo=" crossorigin="anonymous"></script>
    <link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Ubuntu:300,400,500,700&display=swap&subset=cyrillic-ext" rel="stylesheet">
    <link href="catalog/view/theme/sauco/css/vendor.css" rel="stylesheet">
    <link href="catalog/view/theme/sauco/css/style.css?v=1.4" rel="stylesheet">
    <link href="catalog/view/theme/sauco/js/mmenu/mmenu.css" rel="stylesheet">
    {% for style in styles %}
        <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
    {% endfor %}
    {% for script in scripts %}
        <script src="{{ script }}" type="text/javascript"></script>
    {% endfor %}
    <script src="catalog/view/theme/sauco/js/main.js" type="text/javascript"></script>
    {% for link in links %}
        <link href="{{ link.href }}" rel="{{ link.rel }}" />
    {% endfor %}
    {% for analytic in analytics %}
        {{ analytic }}
    {% endfor %}
    {% if custom_css %}
        <style>{{ custom_css }}</style>
    {% endif %}
    {{ script_head }}
</head>
<body>
{{ script_before_body }}
<div id="site">
    <header class="header">
        <div class="header-logo">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-12 pl-0">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="menu-btn"><a href="#menu"><i class="fa fa-bars"></i></a></div>
                            </div>
                            <div class="ml-sm-0 mr-auto">
                                <div id="logo">{% if logo %}<a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-fluid" /></a>{% else %}
                                        <h1><a href="{{ home }}">{{ name }}</a></h1>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="d-flex">
                                {% if informations %}
                                    <ul class="header-information d-xl-flex d-none">
                                        {% for information in informations %}
                                            <li><a href="{{ information.href }}">{{ information.title }}</a></li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                                <div class="header-phone" id="header-phone">
                                    <span><i class="fa fa-phone d-sm-none" aria-hidden="true"></i><span class="d-none d-sm-inline-block">{{ text_contacts }}</span></span>
                                    <ul class="header-phone-list">
                                        {% for phone in phones %}
                                            <li><a href="tel:{{ phone }}">{{ phone }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                {{ cart }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <nav id="menu" class="d-none">
            <ul id="mobile-menu">
                {% for category in categories %}
                    {% if category.children %}
                        <li><a href="{{ category.href }}">{{ category.name }}</a>
                            <ul>
                                {% for child in category.children %}
                                    <li><a href="{{ child.href }}">{{ child.name }}</a></li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% else %}
                        <li><a href="{{ category.href }}">{{ category.name }}</a></li>
                    {% endif %}
                {% endfor %}
                <li><a href="#mobile-menu-contacts">{{ text_contacts }}</a>
                    <ul id="mobile-menu-contacts">
                        {% for phone in phones %}
                            <li><a href="tel:{{ phone }}">{{ phone }}</a></li>
                        {% endfor %}
                        <li><a href="mailto:{{ email }}">{{ email }}</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#mobile-menu-info">{{ text_info }}</a>
                    {% if informations %}
                        <ul id="mobile-menu-info">
                            {% for information in informations %}
                                <li><a href="{{ information.href }}">{{ information.title }}</a></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
                <li><a href="{{ shopping_cart }}">{{ text_shopping_cart }} (<span id="mobile-cart-count">{{ cart_count }}</span>)</a></li>
            </ul>
        </nav>
    </header>
    <div id="cart-invisible">
        <i class="fa fa-shopping-basket" aria-hidden="true"></i>
        <a href="{{ shopping_cart }}"><span id="cart-invisible-count">{{ cart_count }}</span></a>
    </div>