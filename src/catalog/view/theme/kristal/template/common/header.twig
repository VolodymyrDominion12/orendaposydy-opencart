<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<base href="{{ base }}">
{% if description %}
<meta name="description" content="{{ description }}">
{% endif %}
<link rel="preload" href="{{ k_font }}" as="font" type="font/woff2" crossorigin>
{{ k_placeholder }}
<link href="{{ k_css }}" rel="stylesheet">
{% for style in styles %}
<link href="{{ style.href }}" rel="{{ style.rel }}" media="{{ style.media }}">
{% endfor %}
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}">
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}"></script>
{% endfor %}
{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body class="k-body">
{# SVG-спрайт іконок теми (лінійні 24×24, штрих 1.5 — брендбук). Використання: <svg class="k-ico"><use href="#i-phone"/></svg> #}
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="i-plate" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/></symbol>
  <symbol id="i-cutlery" viewBox="0 0 24 24"><path d="M7 3v7a2 2 0 0 0 2 2M11 3v7a2 2 0 0 1-2 2v9M9 3v6M17 21V3c-2 1-3 4-3 7 0 2 1 3 3 3"/></symbol>
  <symbol id="i-glass" viewBox="0 0 24 24"><path d="M7 3h10c0 6-2 9-5 9s-5-3-5-9zM12 12v8M8 21h8M7.5 7h9"/></symbol>
  <symbol id="i-pot" viewBox="0 0 24 24"><path d="M4 10h16v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM2 10h2M20 10h2M8 10V8a4 4 0 0 1 8 0v2M12 4V3"/></symbol>
  <symbol id="i-coffee" viewBox="0 0 24 24"><path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5zM16 10h1.5a2.5 2.5 0 0 1 0 5H16M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3M4 21h14"/></symbol>
  <symbol id="i-bar" viewBox="0 0 24 24"><path d="M3 11h18M5 11v10M19 11v10M8 21h8M9 7V3h2v4M9 7a1 1 0 0 0-1 1v3M11 7a1 1 0 0 1 1 1v3M15 11V6h3v5"/></symbol>
  <symbol id="i-chair" viewBox="0 0 24 24"><path d="M7 3h10M8 3v9M16 3v9M6 12h12v2H6zM7 14l-1 7M17 14l1 7M8 7h8"/></symbol>
  <symbol id="i-textile" viewBox="0 0 24 24"><path d="M3 5h18v4c-2 0-2 2-4 2s-2-2-4-2-2 2-4 2-2-2-4-2-2 2-2 2zM5 11v8M19 11v8M5 19c2 1 4-1 7 0s5 1 7 0"/></symbol>
  <symbol id="i-tent" viewBox="0 0 24 24"><path d="M12 3L2 12h20zM4 12v9M20 12v9M12 3v18M8 21l4-6 4 6M2 21h20"/></symbol>
  <symbol id="i-decor" viewBox="0 0 24 24"><path d="M9 21V11h6v10M7 21h10M12 11V8M12 8c-1.5-1-1.5-3 0-5 1.5 2 1.5 4 0 5z"/></symbol>
  <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M5 19C5 10 10 5 20 4c0 10-5 15-14 15zM5 19l8-8"/></symbol>
  <symbol id="i-box" viewBox="0 0 24 24"><path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10"/></symbol>
  <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 3h3.5l1.5 5-2 1.5a12 12 0 0 0 6.5 6.5L16 14l5 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/></symbol>
  <symbol id="i-viber" viewBox="0 0 24 24"><path d="M12 2.5c5 0 8.5 2.5 8.5 8s-3.5 8-8.5 8c-.9 0-1.8-.1-2.6-.3L6 21v-3.3C4 16.3 3.5 14 3.5 10.5 3.5 5 7 2.5 12 2.5z"/><path d="M9.5 8c.3 2.6 2 4.6 4.5 5.5M13 6.8a3 3 0 0 1 2.6 2.6M13 4.8a5 5 0 0 1 4.6 4.6"/></symbol>
  <symbol id="i-telegram" viewBox="0 0 24 24"><path d="M21 4L3 11l6 2 2 6 3-4 5 4zM9 13l9-7-7 9"/></symbol>
  <symbol id="i-bag" viewBox="0 0 24 24"><path d="M5 8h14l-1 13H6zM9 8V6a3 3 0 0 1 6 0v2"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
  <symbol id="i-grid" viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19"/></symbol>
