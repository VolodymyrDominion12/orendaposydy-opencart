  <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2 .7 3.5 2.8 3.5 6"/></symbol>
  <symbol id="i-truck" viewBox="0 0 24 24"><path d="M2 6h12v11H2zM14 10h4l4 4v3h-8M6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></symbol>
  <symbol id="i-file" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 13h6M9 17h6"/></symbol>
  <symbol id="i-tiktok" viewBox="0 0 24 24"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.5 2.5 4.5 5 4.5"/></symbol>
  <symbol id="i-youtube" viewBox="0 0 24 24"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10 9.5v5l4.5-2.5z"/></symbol>
</svg>
<a class="k-skip" href="#main">{{ k_skip }}</a>

<div class="k-topbar">
  <div class="k-wrap">
    {% if k_nap.address %}
    <span><svg class="k-ico k-ico--sm"><use href="#i-pin"/></svg></span>
    <a href="#contacts">{% if k_nap.city %}{{ k_nap.city }}, {% endif %}{{ k_nap.address }}</a>
    {% endif %}
    {% if k_hours %}<span>{{ k_hours|first }}</span>{% endif %}
    <span class="k-topbar__sp"></span>
    {% if k_viber %}<a href="{{ k_viber }}"><svg class="k-ico k-ico--sm"><use href="#i-viber"/></svg>Viber</a>{% endif %}
    {% if k_telegram %}<a href="{{ k_telegram }}" rel="noopener"><svg class="k-ico k-ico--sm"><use href="#i-telegram"/></svg>Telegram</a>{% endif %}
  </div>
</div>

<header class="k-header">
  <div class="k-wrap">
    <a class="k-iconbtn k-burger" href="#menu" data-k-open="menu" aria-controls="menu" aria-expanded="false" aria-label="{{ k_menu }}"><svg class="k-ico"><use href="#i-menu"/></svg></a>
    <a class="k-logo" href="{{ k_home }}" aria-label="{{ k_home_aria }}">
      <img src="{{ k_logo }}" width="44" height="44" alt="">
      <span class="k-logo__word">{{ k_brand }}</span>
    </a>
    <ul class="k-nav">
      {% if k_cats %}
      <li data-k-mega>
        <button class="k-nav__a k-nav__btn" type="button" aria-expanded="false" aria-controls="k-mega">{{ k_catalog }} <svg class="k-ico k-ico--sm"><use href="#i-down"/></svg></button>
        <div class="k-mega" id="k-mega">
          {% for top in k_cats %}
          <div>
            <h4><a href="{{ top.href }}"><svg class="k-ico"><use href="#i-{{ top.icon }}"/></svg>{{ top.name }}</a></h4>
            {% if top.children %}
            <ul>
              {% for child in top.children %}
              <li><a href="{{ child.href }}">{{ child.name }}</a></li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
          {% endfor %}
          {% if k_phone %}
          <div class="k-mega__promo">
            <span class="k-label k-label--gold">{{ k_promo_label }}</span>
            <p class="k-h3">{{ k_promo_text }}</p>
            <a class="k-btn k-btn--secondary k-btn--sm" href="{{ k_phone.tel }}"><svg class="k-ico k-ico--sm"><use href="#i-phone"/></svg><span class="k-mono">{{ k_phone.display }}</span></a>
          </div>
          {% endif %}
        </div>
      </li>
      {% endif %}
      <li><a class="k-nav__a" href="#contacts">{{ k_contacts }}</a></li>
    </ul>
    {% if k_phone %}
    <a class="k-header__phone" href="{{ k_phone.tel }}">{{ k_phone.display }}</a>
    <a class="k-iconbtn k-header__phone-m" href="{{ k_phone.tel }}" aria-label="{{ k_call }} {{ k_phone.display }}"><svg class="k-ico"><use href="#i-phone"/></svg></a>
    {% endif %}
    <a class="k-header__cart" href="{{ k_cart_href }}"><svg class="k-ico"><use href="#i-bag"/></svg><span class="t">{{ k_cart }}</span>{% if k_cart_count %} <span class="k-mono">({{ k_cart_count }})</span>{% endif %}</a>
    <a class="k-btn k-btn--primary k-header__cta" href="#contacts">{{ k_cta }}</a>
  </div>
</header>

<div class="k-drawer" id="menu" role="dialog" aria-modal="true" aria-label="{{ k_menu }}">
  <div class="k-drawer__head">
    <a class="k-logo" href="{{ k_home }}" aria-label="{{ k_home_aria }}"><img src="{{ k_logo }}" width="44" height="44" alt="" loading="lazy"><span class="k-logo__word">{{ k_brand }}</span></a>
    <a class="k-iconbtn" href="#" data-k-close aria-label="{{ k_menu_close }}"><svg class="k-ico"><use href="#i-close"/></svg></a>
  </div>
  <nav aria-label="{{ k_menu }}">
    {% if k_cats %}
    <p class="k-label k-drawer__label">{{ k_catalog }}</p>
    {% for top in k_cats %}
    {% if top.children %}
    <details>
      <summary>{{ top.name }} <svg class="k-ico"><use href="#i-down"/></svg></summary>
      <ul>
        {% for child in top.children %}
        <li><a href="{{ child.href }}">{{ child.name }}</a></li>
        {% endfor %}
        <li><a class="k-drawer__all" href="{{ top.href }}">{{ k_all_in }} <svg class="k-ico k-ico--sm"><use href="#i-arrow"/></svg></a></li>
      </ul>
    </details>
    {% else %}
    <a class="k-drawer__a" href="{{ top.href }}">{{ top.name }} <svg class="k-ico"><use href="#i-arrow"/></svg></a>
    {% endif %}
    {% endfor %}
    {% endif %}
    <a class="k-drawer__a" href="#contacts">{{ k_contacts }} <svg class="k-ico"><use href="#i-arrow"/></svg></a>
    <div class="k-drawer__contacts">
      {% if k_phone %}
      <a class="k-btn k-btn--primary k-btn--block" href="{{ k_phone.tel }}"><svg class="k-ico"><use href="#i-phone"/></svg><span class="k-mono">{{ k_phone.display }}</span></a>
      {% endif %}
      {% if k_viber or k_telegram %}
      <div class="k-btns">
        {% if k_viber %}<a class="k-btn k-btn--ghost k-btn--grow" href="{{ k_viber }}"><svg class="k-ico"><use href="#i-viber"/></svg>Viber</a>{% endif %}
        {% if k_telegram %}<a class="k-btn k-btn--ghost k-btn--grow" href="{{ k_telegram }}" rel="noopener"><svg class="k-ico"><use href="#i-telegram"/></svg>Telegram</a>{% endif %}
      </div>
      {% endif %}
    </div>
  </nav>
</div>

<main id="main" class="k-main" tabindex="-1">
