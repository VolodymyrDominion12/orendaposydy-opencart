{{ header }}
<section class="k-hero">
  <div class="k-wrap">
    <div class="k-hero__text">
      <h1 class="k-display">{{ kh_h1_text }}</h1>
      <p class="k-lead">{{ kh_lead_text }}</p>
      <div class="k-btns">
        {% if kh_catalog_href %}<a class="k-btn k-btn--primary" href="{{ kh_catalog_href }}">{{ kh_catalog }}</a>{% endif %}
        {% if k_phone_tel %}<a class="k-btn k-btn--ghost" href="{{ k_phone_tel }}"><svg class="k-ico"><use href="#i-phone"/></svg><span class="k-mono">{{ k_phone_display }}</span></a>{% endif %}
        {% if k_viber_href %}<a class="k-btn k-btn--ghost" href="{{ k_viber_href }}"><svg class="k-ico"><use href="#i-viber"/></svg>Viber</a>{% endif %}
      </div>
    </div>
    <div class="k-hero__art">
      {% if kh_hero %}
      <img src="{{ kh_hero.src }}"{% if kh_hero.srcset %} srcset="{{ kh_hero.srcset }}" sizes="(min-width: 1024px) 420px, (min-width: 768px) 280px, 200px"{% endif %} width="{{ kh_hero.width }}" height="{{ kh_hero.height }}" alt="{{ kh_hero_alt }}" fetchpriority="high">
      {% else %}
      <img src="catalog/view/theme/kristal/image/emblem-480.webp" width="480" height="480" alt="{{ kh_hero_alt }}" fetchpriority="high">
      {% endif %}
    </div>
  </div>
</section>
{{ content_top }}

{% if kh_cats %}
<section class="k-section">
  <div class="k-wrap">
    <div class="k-section__head">
      <div>
        <h2 class="k-h2">{{ kh_cats_title }}</h2>
        <p class="k-muted">{{ kh_cats_lead }}</p>
      </div>
    </div>
    <div class="k-cats">
      {% for cat in kh_cats %}
      <a class="k-cat" href="{{ cat.href }}">
        <svg class="k-ico"><use href="#i-{{ cat.icon }}"/></svg>
        <span class="k-cat__name">{{ cat.name }}</span>
        {% if cat.price %}<span class="k-cat__price">{{ cat.price }}</span>{% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if kh_hits %}
<section class="k-section k-section--sunken">
  <div class="k-wrap">
    <div class="k-section__head">
      <div>
        <h2 class="k-h2">{{ kh_hits_title }}</h2>
        <p class="k-muted">{{ kh_hits_lead }}</p>
      </div>
    </div>
    <div class="k-grid k-grid--4">
      {% for product in kh_hits %}
      <article class="k-card">
        <a class="k-card__media" href="{{ product.href }}" tabindex="-1" aria-hidden="true">
          {% if product.k.is_hit %}<span class="k-badge k-badge--hit">{{ kc_hit }}</span>{% endif %}
          <img src="{{ product.k.img.src }}"{% if product.k.img.srcset %} srcset="{{ product.k.img.srcset }}" sizes="(min-width: 1280px) 290px, (min-width: 1024px) 23vw, (min-width: 768px) 31vw, 47vw"{% endif %} width="{{ product.k.img.width }}" height="{{ product.k.img.height }}" alt="{{ product.name }}" loading="lazy">
        </a>
        <div class="k-card__body">
          <h3 class="k-card__name"><a href="{{ product.href }}">{{ product.name }}</a></h3>
          {% if product.k.price %}<p class="k-card__price"><span class="k-price">{{ product.k.price }}</span> <span class="k-buy__unit">{{ product.k.per }}</span></p>{% endif %}
          {% if product.k.min_text %}<p class="k-card__meta">{{ product.k.min_text }}</p>{% endif %}
          {% if product.k.best %}<p class="k-card__vol">{{ product.k.best }}</p>{% endif %}
          <form class="k-card__foot" action="{{ product.href }}" method="get" data-k-add data-k-min="{{ product.k.minimum }}" data-k-hint="{{ product.k.min_hint }}">
            <input type="hidden" name="product_id" value="{{ product.product_id }}">
            <div class="k-qty">
              <button type="button" data-k-step="-1" aria-label="{{ kc_less }}"><svg class="k-ico"><use href="#i-minus"/></svg></button>
              <input type="number" name="quantity" value="{{ product.k.minimum }}" min="{{ product.k.minimum }}" inputmode="numeric" aria-label="{{ kc_qty }}: {{ product.name }}">
              <button type="button" data-k-step="1" aria-label="{{ kc_more_qty }}"><svg class="k-ico"><use href="#i-plus"/></svg></button>
            </div>
            <button class="k-btn k-btn--secondary k-btn--sm" type="submit">{{ kc_add }}</button>
            <p class="k-card__hint" aria-live="polite"></p>
          </form>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="k-section k-section--line">
  <div class="k-wrap">
    <div class="k-section__head">
      <div>
        <span class="k-label k-label--gold">{{ kh_steps_label }}</span>
        <h2 class="k-h2">{{ kh_steps_title }}</h2>
      </div>
    </div>
    <ol class="k-steps">
      <li><h3 class="k-h3">{{ kh_step1_t }}</h3><p class="k-muted">{{ kh_step1 }}</p></li>
      <li><h3 class="k-h3">{{ kh_step2_t }}</h3><p class="k-muted">{{ kh_step2 }}</p></li>
      <li><h3 class="k-h3">{{ kh_step3_t }}</h3><p class="k-muted">{{ kh_step3 }}</p></li>
      <li><h3 class="k-h3">{{ kh_step4_t }}</h3><p class="k-muted">{{ kh_step4 }}</p></li>
    </ol>
  </div>
</section>

{% if kh_numbers %}
<section class="k-section k-section--sunken">
  <div class="k-wrap">
    <h2 class="k-sr">{{ kh_numbers_title }}</h2>
    <div class="k-stats">
      {% for n in kh_numbers %}
      <div><p class="k-stat__n"><em>{{ n.value }}</em></p><p class="k-stat__t">{{ n.label }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if kh_faq or kh_seo %}
<section class="k-section k-section--line">
  <div class="k-wrap k-cols2">
    {% if kh_faq %}
    <div>
      <h2 class="k-h2 k-faq__title">{{ kh_faq_title }}</h2>
      <div class="k-faq">
        {% for item in kh_faq %}
        <details><summary>{{ item.q }} <svg class="k-ico"><use href="#i-plus"/></svg></summary><p>{{ item.a }}</p></details>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% if kh_seo %}
    <div class="k-prose k-seo">{{ kh_seo }}</div>
    {% endif %}
  </div>
</section>
{% endif %}

<section class="k-section k-section--sunken">
  <div class="k-wrap k-leadbox">
    <div>
      <span class="k-label k-label--gold">{{ kh_contact_label }}</span>
      <h2 class="k-h2">{{ kh_contact_title }}</h2>
      <p class="k-lead">{{ kh_contact_lead }}</p>
    </div>
    <div class="k-messengers">
      {% if k_phone_tel %}<a class="k-btn k-btn--primary" href="{{ k_phone_tel }}"><svg class="k-ico"><use href="#i-phone"/></svg><span class="k-mono">{{ k_phone_display }}</span></a>{% endif %}
      {% if k_viber_href %}<a class="k-btn k-btn--ghost" href="{{ k_viber_href }}"><svg class="k-ico"><use href="#i-viber"/></svg>Viber</a>{% endif %}
      {% if k_telegram_href %}<a class="k-btn k-btn--ghost" href="{{ k_telegram_href }}" rel="noopener"><svg class="k-ico"><use href="#i-telegram"/></svg>Telegram</a>{% endif %}
    </div>
  </div>
</section>
{{ content_bottom }}
<div class="k-toast" role="status" aria-live="polite" data-k-toast data-k-ok="{{ kc_added }}" data-k-err="{{ kc_add_error }}" hidden><span data-k-toast-text></span><a href="{{ k_cart_url }}">{{ kc_go_cart }}</a></div>
{{ footer }}
