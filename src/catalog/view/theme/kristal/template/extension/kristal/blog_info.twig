{{ header }}

<main id="main">
  <div class="k-wrap" style="padding-top:1.5rem;padding-bottom:3rem">
    <ol class="k-crumbs">
      {% for crumb in breadcrumbs %}
        {% if loop.last %}
          <li aria-current="page">{{ crumb.text }}</li>
        {% else %}
          <li><a href="{{ crumb.href }}">{{ crumb.text }}</a></li>
        {% endif %}
      {% endfor %}
    </ol>

    <article style="max-width:820px;margin:0 auto">
      <header style="margin-bottom:2rem">
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;font-size:0.85rem;color:var(--accent,#e5a93b)">
          {% if category_title %}
            <span class="k-label k-label--gold">{{ category_title }}</span>
          {% endif %}
          <span>• {{ date_added }}</span>
          {% if author %}
            <span>• {{ author }}</span>
          {% endif %}
        </div>
        <h1 class="k-display" style="margin-top:0.25rem;margin-bottom:1rem;font-size:2.2rem;line-height:1.25">{{ title }}</h1>
        <p class="k-lead" style="color:var(--ink-light);line-height:1.6">{{ summary }}</p>
      </header>

      {% if thumb %}
        <div style="border-radius:14px;overflow:hidden;border:1px solid var(--border,#382f34);margin-bottom:2.5rem;background:#1a1517;max-height:450px">
          <img src="{{ thumb }}" alt="{{ title }}" style="width:100%;height:100%;max-height:450px;object-fit:cover" loading="eager">
        </div>
      {% endif %}

      <!-- Тіло статті -->
      <div style="color:var(--ink-light);line-height:1.75;font-size:1.05rem;margin-bottom:3.5rem">
        {{ content|raw }}
      </div>

      <!-- Пов'язані товари (рекомендований посуд) -->
      {% if products %}
        <section style="background:var(--bg-elevated,#241e21);border:1px solid var(--border,#382f34);border-radius:16px;padding:2rem;margin-bottom:3.5rem">
          <div style="margin-bottom:1.25rem">
            <span class="k-label k-label--gold">Рекомендований посуд</span>
            <h2 class="k-h2" style="margin-top:0.25rem;font-size:1.4rem">Позиції з цієї статті, доступні в оренду</h2>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(180px, 1fr));gap:1.25rem">
            {% for prod in products %}
              <div style="background:var(--bg,#1a1517);border:1px solid var(--border,#382f34);border-radius:10px;padding:0.75rem;display:flex;flex-direction:column">
                <a href="{{ prod.href }}" style="aspect-ratio:1/1;display:block;overflow:hidden;border-radius:6px;background:#141012;margin-bottom:0.5rem">
                  <img src="{{ prod.thumb }}" alt="{{ prod.name }}" style="width:100%;height:100%;object-fit:contain" loading="lazy">
                </a>
                <h3 style="font-size:0.85rem;font-weight:600;margin:0 0 0.5rem;line-height:1.3;flex:1">
                  <a href="{{ prod.href }}" style="color:var(--ink);text-decoration:none">{{ prod.name }}</a>
                </h3>
                <div style="display:flex;align-items:baseline;justify-content:space-between;margin-top:auto;border-top:1px solid rgba(255,255,255,0.05);padding-top:0.4rem">
                  <span style="font-size:1rem;font-weight:700;color:var(--accent,#e5a93b)">{{ prod.price }} ₴</span>
                  <a href="{{ prod.href }}" class="k-btn k-btn--secondary" style="padding:0.2rem 0.6rem;font-size:0.75rem">Оренда</a>
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <!-- CTA блок розрахунку -->
      <div style="background:linear-gradient(135deg,rgba(229,169,59,0.08) 0%,rgba(36,30,33,0.95) 100%);border:1px solid var(--border,#382f34);border-radius:16px;padding:2.5rem;text-align:center;margin-bottom:3rem">
        <h2 class="k-h2" style="margin-bottom:0.5rem">Потрібна допомога з розрахунком посуду?</h2>
        <p style="color:var(--ink-light);max-width:50ch;margin:0 auto 1.5rem;line-height:1.5">Наш менеджер розрахує точну кількість келихів, тарілок та приборів під ваше банкетне меню.</p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
          <a href="/#lead" class="k-btn k-btn--primary">Отримати безкоштовний розрахунок</a>
          <a href="/blog" class="k-btn k-btn--secondary">← До всіх статей</a>
        </div>
      </div>

      <!-- Інші статті -->
      {% if related_posts %}
        <section style="border-top:1px solid var(--border,#382f34);padding-top:2.5rem">
          <h2 class="k-h2" style="margin-bottom:1.5rem;font-size:1.4rem">Читайте також у нашому блозі</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:1.5rem">
            {% for rp in related_posts %}
              <a href="{{ rp.href }}" style="background:var(--bg-elevated,#241e21);border:1px solid var(--border,#382f34);border-radius:10px;overflow:hidden;text-decoration:none;display:block">
                <div style="aspect-ratio:16/10;overflow:hidden;background:#1a1517">
                  <img src="{{ rp.thumb }}" alt="{{ rp.title }}" style="width:100%;height:100%;object-fit:cover" loading="lazy">
                </div>
                <div style="padding:1rem">
                  <span style="font-size:0.75rem;color:var(--ink-muted);margin-bottom:0.25rem;display:block">{{ rp.date_added }}</span>
                  <h3 style="font-size:0.95rem;color:var(--ink);margin:0;line-height:1.3">{{ rp.title }}</h3>
                </div>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </article>
  </div>
</main>

{% if jsonld %}
  {{ jsonld|raw }}
{% endif %}

{{ footer }}
