{{ header }}

<main id="main">
  <div class="k-wrap" style="padding-top:1.5rem;padding-bottom:3rem">
    <ol class="k-crumbs">
      {% for crumb in breadcrumbs %}
        {% if loop.last %}
          <li aria-current="page">{{ crumb.text }}</li>
        {% else %}
          <li><a href="{{ crumb.href }}">{{ crumb.text }}</a></li>
        {% endif %}
      {% endfor %}
    </ol>

    <div style="margin-bottom:2.5rem">
      <span class="k-label k-label--gold">Відгуки клієнтів</span>
      <h1 class="k-display" style="margin-top:0.5rem;margin-bottom:1rem">Що кажуть про «Крістал»</h1>
      <p class="k-lead" style="max-width:70ch;color:var(--ink-light)">Реальні враження молодят, кейтерингових компаній, ресторанів та event-агенцій Львова про якість нашого посуду, пунктуальність доставки та рівень сервісу.</p>
    </div>

    <!-- Рейтингова картка Google Reviews -->
    <div style="background:linear-gradient(135deg,rgba(229,169,59,0.1) 0%,rgba(36,30,33,0.9) 100%);border:1px solid var(--border,#382f34);border-radius:16px;padding:2rem;margin-bottom:3rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:1.5rem">
        <div style="font-size:3.5rem;font-weight:800;color:var(--accent,#e5a93b);line-height:1">
          {{ stats.avg_rating }}
        </div>
        <div>
          <div style="color:#f59e0b;font-size:1.4rem;letter-spacing:2px;margin-bottom:0.25rem">★★★★★</div>
          <div style="color:var(--ink);font-weight:600;font-size:1.05rem">Бездоганний рейтинг на основі {{ stats.count }} відгуків</div>
          <div style="color:var(--ink-muted);font-size:0.85rem">Джерело: Google Maps & підтверджені замовлення</div>
        </div>
      </div>
      <div>
        <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="k-btn k-btn--secondary" style="padding:0.6rem 1.25rem">
          Залишити відгук у Google ↗
        </a>
      </div>
    </div>

    <!-- Список відгуків -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(340px, 1fr));gap:2rem;margin-bottom:4rem">
      {% for t in testimonials %}
        <article style="background:var(--bg-elevated,#241e21);border:1px solid var(--border,#382f34);border-radius:14px;padding:1.75rem;display:flex;flex-direction:column;position:relative">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem">
            <div>
              <h3 style="font-size:1.1rem;font-weight:700;color:var(--ink);margin:0 0 0.25rem">{{ t.author_name }}</h3>
              {% if t.author_role %}
                <span style="font-size:0.85rem;color:var(--accent,#e5a93b)">{{ t.author_role }}</span>
              {% endif %}
            </div>
            <div style="text-align:right">
              <div style="color:#f59e0b;font-size:0.95rem;letter-spacing:1px">
                {% for i in 1..t.rating %}★{% endfor %}
              </div>
              <span style="font-size:0.75rem;color:var(--ink-muted)">{{ t.source }}</span>
            </div>
          </div>

          <p style="color:var(--ink-light);font-size:0.95rem;line-height:1.6;margin-bottom:1.5rem;flex:1">«{{ t.text }}»</p>

          <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.05);padding-top:0.75rem;font-size:0.8rem;color:var(--ink-muted)">
            <span>{{ t.event_title }}</span>
            <time>{{ t.date_added }}</time>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Блок заклик до співпраці -->
    <div style="text-align:center;background:var(--bg-elevated,#241e21);border:1px solid var(--border,#382f34);border-radius:16px;padding:3rem 1.5rem">
      <h2 class="k-h2" style="margin-bottom:0.75rem">Оцініть переваги сервісу «Крістал» на вашій події</h2>
      <p style="color:var(--ink-light);max-width:55ch;margin:0 auto 1.5rem;line-height:1.5">Ми цінуємо довіру кожного клієнта: від невеликого сімейного ювілею до масштабного кейтерингу на 500 гостей.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
        <a href="/#lead" class="k-btn k-btn--primary">Замовити розрахунок за 15 хв</a>
        <a href="/portfolio" class="k-btn k-btn--secondary">Переглянути портфоліо кейсів</a>
      </div>
    </div>
  </div>
</main>

{% if jsonld %}
  {{ jsonld|raw }}
{% endif %}

{{ footer }}
