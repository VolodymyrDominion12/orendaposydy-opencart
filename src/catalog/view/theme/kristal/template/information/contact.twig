{{ header }}

<main id="main" class="k-wrap k-page">
  <nav aria-label="Навігація">
    <ol class="k-crumbs">
      {% for breadcrumb in breadcrumbs %}
      <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
      {% endfor %}
    </ol>
  </nav>

  <div class="k-page__head">
    <h1 class="k-h1">{{ heading_title }}</h1>
  </div>

  <div class="k-cols2" style="gap:var(--space-8);margin-top:var(--space-6);align-items:start">
    <!-- Ліва колонка: Контактні дані та графік -->
    <div>
      <div class="k-panel k-panel--gold" style="padding:var(--space-6)">
        <h2 class="k-h3" style="margin-top:0"><svg class="k-ico"><use href="#i-pin"/></svg> {{ text_address }}</h2>
        <p style="font-size:1.1rem;margin:var(--space-2) 0"><strong>{{ address }}</strong></p>
        <p class="k-muted k-small">{{ comment }}</p>

        <hr style="border:none;border-top:1px solid var(--line);margin:var(--space-4) 0">

        <h3 class="k-h4"><svg class="k-ico"><use href="#i-phone"/></svg> {{ text_telephone }}</h3>
        <p style="margin:var(--space-2) 0">
          <a href="tel:{{ telephone_raw }}" class="k-mono" style="font-size:1.25rem;font-weight:bold;color:var(--ink)">{{ telephone }}</a>
        </p>
        <div class="k-btns" style="margin-top:var(--space-3)">
          <a href="{{ viber_url }}" class="k-btn k-btn--ghost k-btn--sm"><svg class="k-ico"><use href="#i-viber"/></svg> Viber</a>
          <a href="{{ telegram_url }}" class="k-btn k-btn--ghost k-btn--sm"><svg class="k-ico"><use href="#i-telegram"/></svg> Telegram</a>
        </div>

        <hr style="border:none;border-top:1px solid var(--line);margin:var(--space-4) 0">

        <h3 class="k-h4"><svg class="k-ico"><use href="#i-clock"/></svg> {{ text_open }}</h3>
        <p style="margin:var(--space-2) 0">{{ open }}</p>
      </div>

      <!-- Інтерактивна карта або схема -->
      <div class="k-panel" style="margin-top:var(--space-6);padding:0;overflow:hidden;border-radius:var(--radius-md)">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2572.2981324151744!2d24.045431676878233!3d49.85699477148481!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x473add0e0f3938ab%3A0xe5435017c69992d9!2z0LLRg9C70LjRhtGPINCR0L7Qs9C00LDQvdCwINCl0LzQtdC70YzQvdC40YbRjNC60L7Qs9C-LCAxMDYsINCb0YzQstGW0LIsINCb0YzQstGW0LLRgdGM0LrQsCDQvtCx0LvQsNGB0YLRjCwgNzkwMDA!5e0!3m2!1suk!2sua!4v1700000000000!5m2!1suk!2sua" 
          width="100%" 
          height="280" 
          style="border:0;display:block" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          title="Склад компанії Крістал на карті">
        </iframe>
      </div>
    </div>

    <!-- Права колонка: Форма зворотного зв'язку -->
    <div>
      <div class="k-panel" style="padding:var(--space-6)">
        <h2 class="k-h3" style="margin-top:0"><svg class="k-ico"><use href="#i-file"/></svg> {{ text_contact }}</h2>
        <p class="k-muted k-small">Маєте запитання або потрібна консультація щодо підбору посуду? Залиште повідомлення, і ми зв'яжемося з вами протягом 15 хвилин у робочий час.</p>

        <form action="{{ action }}" method="post" enctype="multipart/form-data" class="k-form" style="margin-top:var(--space-4)">
          <div class="k-field {% if error_name %}has-error{% endif %}">
            <span>{{ entry_name }} *</span>
            <input type="text" name="name" value="{{ name }}" id="input-name" class="k-input" placeholder="Олександр" required />
            {% if error_name %}
            <div class="text-danger k-small" style="color:var(--err)">{{ error_name }}</div>
            {% endif %}
          </div>

          <div class="k-field {% if error_email %}has-error{% endif %}">
            <span>{{ entry_email }} *</span>
            <input type="text" name="email" value="{{ email }}" id="input-email" class="k-input" placeholder="+38 (067) 000-00-00 або name@mail.com" required />
            {% if error_email %}
            <div class="text-danger k-small" style="color:var(--err)">{{ error_email }}</div>
            {% endif %}
          </div>

          <div class="k-field {% if error_enquiry %}has-error{% endif %}">
            <span>{{ entry_enquiry }} *</span>
            <textarea name="enquiry" rows="5" id="input-enquiry" class="k-input" placeholder="Опишіть вашу подію, дату або необхідний інвентар..." required>{{ enquiry }}</textarea>
            {% if error_enquiry %}
            <div class="text-danger k-small" style="color:var(--err)">{{ error_enquiry }}</div>
            {% endif %}
          </div>

          <button type="submit" class="k-btn k-btn--primary k-btn--block" style="margin-top:var(--space-4)">
            {{ button_submit }}
          </button>
        </form>
      </div>
    </div>
  </div>
</main>

{% if business_schema_json %}
<script type="application/ld+json">{{ business_schema_json|raw }}</script>
{% endif %}

{{ footer }}
