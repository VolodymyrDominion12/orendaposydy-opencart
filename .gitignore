# ---------------------------------------------------------------------------
# Що НЕ потрапляє в git.
#
# Принцип: у репозиторії — тільки те, що ми самі написали або змінили.
# Усе згенероване, секретне та велике (зображення товарів) — ні.
# ---------------------------------------------------------------------------

# --- Секрети --------------------------------------------------------------
.env
.env.*
!.env.example

# Бойові доступи до БД. На проді ці файли містять справжні паролі,
# локально — вказують на localhost. Ніколи не комітяться.
src/config.php
src/admin/config.php
# Копії бойових конфігів, які робить make-config.sh
src/config.php.prod-backup-*
src/admin/config.php.prod-backup-*

# --- Згенероване OpenCart -------------------------------------------------
# Кеш, логи, сесії, завантаження і згенеровані OCMOD-модифікації.
src/system/storage/
# На проді storage називається storage_kozak і лежить у корені сайту.
# Це той самий кеш/логи/сесії — у git не треба.
src/storage_kozak/
# Файли, які віддаються покупцям (цифрові товари), і тимчасові завантаження
src/download/

# Прев'ю зображень (генеруються на льоту)
src/image/cache/

# --- Велике: зображення товарів та архіви ---------------------------------
# Сотні мегабайт зображень, які вже лежать на проді:
src/image/catalog/*
# ...крім наших файлів (заглушки, іконки теми kristal)
!src/image/catalog/kristal/

# Архіви та бекапи (часто залишаються після вивантаження з хостингу)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- Робочі дані ----------------------------------------------------------
# Офіційні пакети OpenCart для оновлення ядра (фіча 018) — великі, беруться з GitHub
vendor-src/
dumps/
backups/
.cache/

# --- Логи -----------------------------------------------------------------
*.log
error_log

# --- Сміття, тимчасові файли та IDE ---------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~
*.bak
*.tmp
nppBackup/
__pycache__/

# --- Локальні утиліти -----------------------------------------------------
tools/local-*

# --- Мобільний аудит (make mobile-setup / make test-mobile) ---------------
tests/mobile/node_modules/
tests/mobile/out/
tests/mobile/package-lock.json
